#!/bin/bash
#
# SAL C Test Runner Script
#

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BUILD_DIR="@CMAKE_CURRENT_BINARY_DIR@"
SRC_DIR="@CMAKE_CURRENT_SOURCE_DIR@"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

# Test results
TOTAL_TESTS=0
PASSED_TESTS=0
FAILED_TESTS=0

print_header() {
    echo ""
    echo "========================================"
    echo "$1"
    echo "========================================"
}

print_success() {
    echo -e "${GREEN}[SUCCESS]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

run_test() {
    local test_name=$1
    local test_cmd=$2

    TOTAL_TESTS=$((TOTAL_TESTS + 1))

    echo ""
    echo "Running: $test_name"
    echo "----------------------------------------"

    if eval "$test_cmd"; then
        PASSED_TESTS=$((PASSED_TESTS + 1))
        print_success "$test_name"
    else
        FAILED_TESTS=$((FAILED_TESTS + 1))
        print_error "$test_name"
    fi
}

# Main
main() {
    print_header "SAL C Test Suite"

    echo "Build Directory: $BUILD_DIR"
    echo "Source Directory: $SRC_DIR"
    echo ""

    # Check if test executables exist
    cd "$BUILD_DIR"

    # Run test_basic
    if [ -x "./test_basic" ]; then
        run_test "test_basic (Core Types)" "./test_basic"
    else
        print_warning "test_basic not found, skipping..."
    fi

    # Run test_rados_driver
    if [ -x "./test_rados_driver" ]; then
        run_test "test_rados_driver (RADOS Driver)" "./test_rados_driver"
    else
        print_warning "test_rados_driver not found, skipping..."
    fi

    # Run test_dbstore_driver
    if [ -x "./test_dbstore_driver" ]; then
        run_test "test_dbstore_driver (DBStore Driver)" "./test_dbstore_driver"
    else
        print_warning "test_dbstore_driver not found, skipping..."
    fi

    # Run test_integration
    if [ -x "./test_integration" ]; then
        run_test "test_integration (Comprehensive)" "./test_integration"
    else
        print_warning "test_integration not found, skipping..."
    fi

    # Summary
    print_header "Test Summary"
    echo "Total Tests:  $TOTAL_TESTS"
    echo "Passed:       $PASSED_TESTS"
    echo "Failed:       $FAILED_TESTS"
    echo ""

    if [ $FAILED_TESTS -eq 0 ]; then
        print_success "All tests passed!"
        exit 0
    else
        print_error "$FAILED_TESTS test(s) failed!"
        exit 1
    fi
}

main "$@"
